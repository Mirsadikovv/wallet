# ── HTTP ──────────────────────────────────────────
HTTP_PORT=8080

# ── PostgreSQL ────────────────────────────────────
# Docker: POSTGRES_HOST is overridden per service (db / localhost)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=wallet_db
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable
POSTGRES_TIME_ZONE=UTC

# ── Redis ─────────────────────────────────────────
# Docker: REDIS_ADDR is overridden automatically (redis:6379)
# Local:  set to localhost:6379
REDIS_ADDR=localhost:6379

# ── JWT ───────────────────────────────────────────
JWT_SECRET=change_me_at_least_32_chars_secret!!
JWT_EXPIRED=3600
JWT_REFRESH_EXPIRED=86400

# ── TON ───────────────────────────────────────────
TON_NETWORK=testnet
ENCRYPTION_KEY=change_me_exactly_32_chars_key!!

# ── Telegram Bot ──────────────────────────────────
BOT_TOKEN=your_bot_token_here
ADMINS=123456789
WEB_APP_URL=https://your-domain.com
DEBUG=false

# ── Frontend ──────────────────────────────────────
FRONTEND_PORT=80
